{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/junbi-archive/Autonomous-AI/schema/xal-1.0.schema.json",
  "title": "XAL (eXplainable Action Log) 1.0 - 자율형 AI 보안대응 설명가능성 로그",
  "description": "고시안 제4조 필수 기록 항목. 레코드는 JSON Lines 원장에 해시체인으로 연결된다(제5조).",
  "oneOf": [{"$ref": "#/$defs/action"}, {"$ref": "#/$defs/review"}],
  "$defs": {
    "common": {
      "type": "object",
      "required": ["schema_version", "record_type", "seq", "log_id", "timestamp", "incident_id", "prev_hash", "hash"],
      "properties": {
        "schema_version": {"const": "XAL-1.0"},
        "seq": {"type": "integer", "minimum": 1, "description": "원장 내 순번"},
        "log_id": {"type": "string"},
        "timestamp": {"type": "string", "format": "date-time"},
        "incident_id": {"type": "string"},
        "prev_hash": {"$ref": "#/$defs/sha256", "description": "직전 레코드 해시 (최초는 0x64)"},
        "hash": {"$ref": "#/$defs/sha256", "description": "hash 필드를 제외한 정규화 JSON(키 정렬, 공백 없음, UTF-8)의 SHA-256"}
      }
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "action": {
      "allOf": [{"$ref": "#/$defs/common"}],
      "required": ["agency_id", "system", "action", "rationale", "evidence", "confidence", "risk", "approval", "execution", "security_flags", "policy_version"],
      "properties": {
        "record_type": {"const": "ACTION"},
        "agency_id": {"type": "string"},
        "system": {
          "type": "object", "required": ["vendor", "product", "model_version"],
          "description": "제품 식별 정보 (알고리즘 내부 정보는 기록하지 않음, 제14조)"
        },
        "action": {
          "type": "object", "required": ["type", "target", "target_grade"],
          "properties": {
            "type": {"enum": ["ALERT", "COLLECT_FORENSICS", "BLOCK_IP", "QUARANTINE_FILE", "DISABLE_ACCOUNT", "ISOLATE_HOST", "DELETE_ASSET", "BLOCK_EXTERNAL_SERVICE"]},
            "target": {"type": "string"},
            "target_grade": {"enum": ["C", "S", "O", "-"], "description": "N2SF 등급"},
            "parameters": {"type": "object"}
          }
        },
        "rationale": {
          "type": "object", "required": ["summary", "reasoning_steps"],
          "properties": {
            "summary": {"type": "string", "minLength": 1},
            "reasoning_steps": {"type": "array", "minItems": 1, "items": {"type": "string"}}
          }
        },
        "evidence": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["evidence_id", "source", "sha256"],
            "properties": {
              "evidence_id": {"type": "string"},
              "source": {"type": "string"},
              "sha256": {"$ref": "#/$defs/sha256"},
              "collected_at": {"type": "string"},
              "excerpt": {"type": "string"}
            }
          }
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "risk": {
          "type": "object", "required": ["tier", "level", "mode", "factors"],
          "properties": {
            "tier": {"enum": [1, 2, 3]},
            "level": {"enum": ["LOW", "MEDIUM", "HIGH"]},
            "mode": {"enum": ["AUTO", "POST_REVIEW", "PRE_APPROVAL"]},
            "factors": {"type": "array", "items": {"type": "string"}}
          }
        },
        "approval": {
          "type": "object", "required": ["mode", "status"],
          "properties": {
            "mode": {"enum": ["AUTO", "POST_REVIEW", "PRE_APPROVAL"]},
            "status": {"enum": ["AUTO_EXECUTED", "PENDING_REVIEW", "APPROVED", "REJECTED"]},
            "approver": {"type": "string"},
            "requested_at": {"type": "string"},
            "decided_at": {"type": "string"},
            "comment": {"type": "string"},
            "presented_warnings": {"type": "array", "items": {"type": "string"}},
            "review_due": {"type": "string"}
          }
        },
        "execution": {
          "type": "object", "required": ["status"],
          "properties": {"status": {"enum": ["EXECUTED", "NOT_EXECUTED"]}, "executed_at": {"type": "string"}, "effect": {"type": "string"}, "reason": {"type": "string"}}
        },
        "security_flags": {
          "type": "array",
          "items": {"type": "object", "required": ["code", "severity", "detail"],
                    "properties": {"code": {"enum": ["INDIRECT_PROMPT_INJECTION", "TARGET_FROM_UNTRUSTED_TEXT", "LOW_CONFIDENCE"]},
                                   "severity": {"enum": ["HIGH", "MEDIUM", "LOW"]}}}
        },
        "policy_version": {"type": "string"}
      }
    },
    "review": {
      "allOf": [{"$ref": "#/$defs/common"}],
      "required": ["review_kind", "ref_log_id", "reviewer", "verdict", "remediation", "comment"],
      "properties": {
        "record_type": {"const": "REVIEW"},
        "review_kind": {"enum": ["POST_EXECUTION", "INCIDENT_INVESTIGATION"]},
        "ref_log_id": {"type": "string"},
        "reviewer": {"type": "string"},
        "verdict": {"enum": ["TRUE_POSITIVE", "FALSE_POSITIVE", "INJECTION", "INCONCLUSIVE"]},
        "remediation": {"type": "string"},
        "comment": {"type": "string"}
      }
    }
  }
}
